    {
      "parameters": {
        "jsCode": "const o = $input.first().json.body;\nconst items = o.items.map(i => `• ${i.name} (${i.variant}) × ${i.quantity}`).join('\\n');\n\n// Mensaje para el CLIENTE\nconst clientText = `<b>¡Pedido recibido! 🙌</b>\nGracias ${o.customer.name}, ya tenemos tu pedido <b>#${o.shortId}</b>\n\n${items}\n\n<b>Total:</b> $${o.totalAmount.toLocaleString('es-CO')}\n<b>Envío a:</b> ${o.customer.city}\n\n${o.paymentMethod === 'transferencia'   \n  ? '💳 Para confirmar tu pedido, realiza la transferencia y envíanos el comprobante aquí mismo 📎\\n\\n(En el siguiente mensaje te enviamos los datos bancarios)'  \n  : '📦 Tu pedido es <b>contraentrega</b>. Lo alistamos y te avisamos cuando salga con el transportador.'}  \n  \nVer tu pedido: ${o.trackingUrl}`;\n\n\n// Mensaje para el ADMIN  \nconst adminText = `📋 <b>NUEVO PEDIDO #${o.shortId}</b>  \n  \n👤 ${o.customer.name} — ${o.customer.phone}  \n📍 ${o.customer.city}  \n💰 $${o.totalAmount.toLocaleString('es-CO')} — ${o.paymentMethod}  \n  \n${items}`;  \n  \nreturn [{   \n  clientText,   \n  adminText, \n  text: adminText,\n  chatId: o.customer.phone,      // para Telegram (usa chatId numérico)  \n  clientPhone: o.customer.phone,  // para WhatsApp (número con código país)  \n  orderId: o.orderId,  \n  paymentMethod: o.paymentMethod  \n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        -48
      ],
      "id": "656d0966-883a-439f-9a0c-d25fdf71ea91",
      "name": "Build PENDIENTE message"
    },
    {
      "parameters": {
        "jsCode": "const o = $input.first().json.body;\nconst text = `<b>Pedido confirmado ✅</b>\n\n${o.customer.name.split(' ')[0]}, estamos alistando tu pedido <b>#${o.shortId}</b> con todo el cariño 🌸\n\nTe aviso apenas salga con el transportador.\n\nSeguir pedido: ${o.trackingUrl}`;\nreturn [{ text, chatId: o.customer.phone, orderId: o.orderId }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        256
      ],
      "id": "3e5a1d84-c7ff-4fef-b5a1-c592c6b8a814",
      "name": "Build CONFIRMADO message"
    },
    {
      "parameters": {
        "jsCode": "const o = $input.first().json.body;\nconst trackingInfo = o.trackingCode \n  ? `<b>Guía:</b> ${o.trackingCode}${o.trackingCarrier ? ` (${o.trackingCarrier})` : ''}\\n\\n` \n  : '';\n\nconst text = `<b>¡Tu pedido va en camino! 🚚</b>\n\n${o.customer.name.split(' ')[0]}, tu pedido <b>#${o.shortId}</b> salió hacia ${o.customer.city}.\n\n${trackingInfo}Llega entre 2 y 5 días hábiles. Si alguien responde por ti en la dirección, avísame para ajustarlo 🤝\n\nSeguir pedido: ${o.trackingUrl}`;\nreturn [{ text, chatId: o.customer.phone, orderId: o.orderId }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        416
      ],
      "id": "17993049-588f-468f-a255-f2eff853f1bc",
      "name": "Build ENVIADO message"
    },
    {
      "parameters": {
        "jsCode": "const o = $input.first().json.body;\nconst text = `<b>¡Tu pedido fue entregado! 🎉</b>\n\nEspero que ames lo que te llegó, ${o.customer.name.split(' ')[0]} 💕\n\nSi tienes un momento, me encantaría saber qué te pareció. Tu opinión nos ayuda un montón 🙏\n\nY como detalle para tu próxima compra, te dejo este cupón:\n\n<b>EMA10</b> — 10% off en tu siguiente pedido ✨\n\nVálido por 30 días. Gracias por elegirnos 🌸`;\nreturn [{ text, chatId: o.customer.phone, orderId: o.orderId }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        592
      ],
      "id": "fa8dbde2-91f5-4d1d-870a-f9349c30f993",
      "name": "Build ENTREGADO message"
    },
    {
      "parameters": {
        "jsCode": "const o = $input.first().json.body;\nconst text = `Hola ${o.customer.name.split(' ')[0]}, tu pedido <b>#${o.shortId}</b> fue cancelado.\n\nSi fue por error o quieres retomarlo, escríbeme y lo solucionamos 🙏`;\nreturn [{ text, chatId: o.customer.phone, orderId: o.orderId }];"
      },
      "type": "n8n-nodes-base.code",
