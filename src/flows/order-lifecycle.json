    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO whatsapp_messages \n  (id, order_id, direction, to_phone, message_text, status, provider, sent_at, created_at)\nVALUES \n  (gen_random_uuid(),\n   '{{ $('Webhook').item.json.body.orderId }}',\n   'OUTBOUND',\n   '{{ $json.result.chat.id }}',\n   $${{ JSON.stringify($json.result.text) }}$$,\n   'SENT',\n   'WA_ME',\n   NOW(),\n   NOW());",
