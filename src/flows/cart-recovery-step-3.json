    {
      "parameters": {
        "functionCode": "const cart = $json;\nconst items = cart.items || [];\n\nconst enriched = items.map(i => ({\n  variantId: i.variantId,\n  name: i.variant?.product?.name || 'producto',\n  price: Number(i.unitPrice),\n  quantity: i.quantity,\n  imageUrl: i.variant?.product?.images?.[0]?.imageUrl || null,\n}));\n\nconst topProduct = enriched.sort((a, b) => b.price - a.price)[0] \n  || { name: 'producto seleccionado', price: 0 };\n\n// Nombre del cliente (si existe)\nconst customerName = cart.customer?.name || null;\n\n// Link de checkout que restaura el carrito\nconst checkoutUrl = `http://host.docker.internal:3000/checkout?cart=${cart.sessionId}`;\n\nreturn [{\n  cartId: cart.id,\n  sessionId: cart.sessionId,\n  customerId: cart.customerId,\n  phone: cart.phone,\n  name: customerName,\n  total: Number(cart.totalAmount),\n  items: enriched,\n  topProduct,\n  checkoutUrl,\n  step: 3,\n}];"
      },
      "id": "bd54c0c1-d591-4f61-9c6d-1237fa849d81",
