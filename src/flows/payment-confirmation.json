    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst phone = msg.from.id.toString(); // en pruebas = tu chatId\nconst fileId = msg.photo[msg.photo.length - 1].file_id; // mayor resolución\nconst chatId = msg.chat.id;\n\nreturn [{ phone, fileId, chatId, fromId: msg.from.id }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
