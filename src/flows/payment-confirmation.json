    {
      "parameters": {
        "jsCode": "const shortId =$input.first().json.id.slice(0, 8).toUpperCase()\nconst id = $input.first().json.id\nconst total_amount = $input.first().json.total_amount\nconst payment_method = $input.first().json.payment_method\nconst customer_name = $input.first().json.customer_name\nconst phone = $input.first().json.phone\n\nreturn {\n  shortId, id, total_amount, payment_method, customer_name, phone\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -384
      ],
      "id": "99468cdd-c0e6-4937-bdc9-a95596ed4c80",
      "name": "Transform Data"
    },
    {
      "parameters": {
        "jsCode": "const cb = $input.first().json.callback_query;\nconst data = cb.data; // 'CONFIRM_uuid' o 'REJECT_uuid'\nconst [action, orderId] = data.split('_').reduce((acc, part, i) => {\n  if (i === 0) acc[0] = part;  else acc[1] = (acc[1] ? acc[1] + '_' + part : part);\n  return acc;}, ['', '']);\n\nconst adminChatId = cb.message.chat.id;\nconst messageId = cb.message.message_id;\n\nreturn [{ action, orderId, adminChatId, messageId }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
