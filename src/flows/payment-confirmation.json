    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT o.id, o.\"total_amount\", o.\"payment_method\",\n       c.name as customer_name, c.phone\nFROM \"orders\" o\nJOIN \"customers\" c ON c.id = o.\"customer_id\"\nWHERE c.phone = $1\n  AND o.status = 'PENDIENTE'\n  AND o.\"payment_method\" = 'transferencia'\nORDER BY o.\"created_at\" DESC\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ $('Extract message data').item.json.phone }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        512,
        -384
      ],
