    {
      "parameters": {
        "functionCode": "const cart = $json;\nconst items = cart.items || [];\n\nconst enriched = items.map(i => ({\n  variantId: i.variantId,\n  name: i.variant?.product?.name || 'producto',\n  price: Number(i.unitPrice),\n  quantity: i.quantity,\n  imageUrl: i.variant?.product?.images?.[0]?.imageUrl || null,\n}));\n\nconst topProduct = enriched.sort((a, b) => b.price - a.price)[0] \n  || { name: 'producto seleccionado', price: 0 };\n\n// Nombre del cliente (si existe)\nconst customerName = cart.customer?.name || null;\n\n// Link de checkout que restaura el carrito\nconst checkoutUrl = `http://localhost:3000/checkout?cart=${cart.sessionId}`;\n\nreturn [{\n  cartId: cart.id,\n  sessionId: cart.sessionId,\n  customerId: cart.customerId,\n  phone: cart.phone,\n  name: customerName,\n  total: Number(cart.totalAmount),\n  items: enriched,\n  topProduct,\n  checkoutUrl,\n  step: 2,\n}];"
      },
      "id": "98f2f809-ea4d-48ab-ad0f-e5a080e89752",
