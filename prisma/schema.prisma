generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  name         String
  lastName     String?   @map("last_name")
  phone        String?   @unique
  role         UserRole  @default(CLIENT)
  isActive     Boolean   @default(true) @map("is_active")
  resetToken   String?   @map("reset_token")
  resetExpires DateTime? @map("reset_expires")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  customer     Customer?

  @@map("users")
}

model Customer {
  id               String            @id @default(uuid())
  name             String
  phone            String            @unique
  address          String?
  city             String?
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  userId           String?           @unique @map("user_id")
  welcomeSentAt    DateTime? @map("welcome_sent_at")  
  lastPurchaseAt   DateTime? @map("last_purchase_at")  
  repurchaseStep   Int       @default(0) @map("repurchase_step")  
  winbackSentAt    DateTime? @map("winback_sent_at")  
  totalSpent       Decimal   @default(0) @map("total_spent") @db.Decimal(10, 2)  
  orderCount       Int       @default(0) @map("order_count")
  carts            Cart[]
  conversations    Conversation[]
  user             User?             @relation(fields: [userId], references: [id])
  orders           Order[]
  whatsappMessages WhatsappMessage[]
  reviews     Review[]
  coupons     Coupon[]
  couponUses  CouponUse[]

  @@map("customers")
}

model Product {
  id          String                 @id @default(uuid())
  name        String
  slug        String                 @unique
  description String?
  category    String
  isActive    Boolean                @default(true) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  embedding   Unsupported("vector")?
  images      ProductImage[]
  variants    ProductVariant[]
  reviews       Review[]

  @@index([embedding])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_images")
}

model ProductVariant {
  id             String      @id @default(uuid())
  productId      String      @map("product_id")
  sku            String      @unique
  attributeName  String      @map("attribute_name")
  attributeValue String      @map("attribute_value")
  price          Decimal     @db.Decimal(10, 2)
  originalPrice  Decimal?    @map("original_price") @db.Decimal(10, 2)
  stock          Int         @default(0)
  createdAt      DateTime    @default(now()) @map("created_at")
  cartItems      CartItem[]
  orderItems     OrderItem[]
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model Order {
  id               String            @id @default(uuid())
  customerId       String            @map("customer_id")
  paymentMethod    String            @map("payment_method")
  totalAmount      Decimal           @map("total_amount") @db.Decimal(10, 2)
  status           OrderStatus       @default(PENDIENTE)
  notes            String?
  trackingCode    String?   @map("tracking_code")  
  trackingCarrier String?   @map("tracking_carrier") // Servientrega, Coordinadora, etc.
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deliveredAt         DateTime?   @map("delivered_at")  
  reviewRequestedAt   DateTime?   @map("review_requested_at")  
  reviewedAt          DateTime?   @map("reviewed_at")  
  paymentRecoveryStep Int         @default(0) @map("payment_recovery_step")  
  paymentAbandonedAt  DateTime?   @map("payment_abandoned_at")  
  appliedCouponCode   String?     @map("applied_coupon_code")  
  discountAmount      Decimal     @default(0) @map("discount_amount") @db.Decimal(10, 2)  
  shippingAmount      Decimal     @default(0) @map("shipping_amount") @db.Decimal(10, 2)

  events           OrderEvent[]
  items            OrderItem[]
  customer         Customer          @relation(fields: [customerId], references: [id])
  whatsappMessages WhatsappMessage[]
  reviews             Review[]  
  couponUses          CouponUse[]

  @@map("orders")
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String         @map("order_id")
  variantId String         @map("variant_id")
  quantity  Int
  unitPrice Decimal        @map("unit_price") @db.Decimal(10, 2)
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_events")
}

model WhatsappMessage {
  id          String      @id @default(uuid())
  orderId     String?     @map("order_id")
  customerId  String?     @map("customer_id")
  direction   WaDirection @default(OUTBOUND)
  toPhone     String      @map("to_phone")
  fromPhone   String?     @map("from_phone")
  messageText String      @map("message_text")
  context     Json?
  status      WaStatus    @default(DRAFT)
  provider    WaProvider  @default(WA_ME)
  sentAt      DateTime?   @map("sent_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  customer    Customer?   @relation(fields: [customerId], references: [id])
  order       Order?      @relation(fields: [orderId], references: [id])

  @@map("whatsapp_messages")
}

model Cart {
  id           String     @id @default(uuid())
  customerId   String?    @map("customer_id")
  sessionId    String     @unique @map("session_id")
  phone        String?
  email        String?
  status       CartStatus @default(ACTIVE)
  totalAmount  Decimal    @default(0) @map("total_amount") @db.Decimal(10, 2)
  recoveryStep Int        @default(0) @map("recovery_step")
  lastActivity DateTime   @default(now()) @map("last_activity")
  recoveredAt  DateTime?  @map("recovered_at")
  orderId      String?    @unique @map("order_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  items        CartItem[]
  customer     Customer?  @relation(fields: [customerId], references: [id])

  @@index([status, lastActivity])
  @@index([phone])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String         @map("cart_id")
  variantId String         @map("variant_id")
  quantity  Int            @default(1)
  unitPrice Decimal        @map("unit_price") @db.Decimal(10, 2)
  addedAt   DateTime       @default(now()) @map("added_at")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Conversation {
  id            String                @id @default(uuid())
  customerId    String?               @map("customer_id")
  phone         String
  channel       Channel               @default(TELEGRAM)
  status        ConvStatus            @default(BOT)
  lastMessageAt DateTime              @default(now()) @map("last_message_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  messages      ConversationMessage[]
  customer      Customer?             @relation(fields: [customerId], references: [id])

  @@index([phone])
  @@index([status, lastMessageAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  role           MsgRole
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

// ============ REVIEWS ============  
model Review {  
  id         String   @id @default(uuid())  
  orderId    String   @map("order_id")  
  customerId String   @map("customer_id")  
  productId  String?  @map("product_id")  
  rating     Int  
  comment    String?  
  photoUrl   String?  @map("photo_url")  
  verified   Boolean  @default(true)  
  published  Boolean  @default(false)  
  createdAt  DateTime @default(now()) @map("created_at")  
  
  order    Order    @relation(fields: [orderId], references: [id])  
  customer Customer @relation(fields: [customerId], references: [id])  
  product  Product? @relation(fields: [productId], references: [id])  
  
  @@index([customerId])  
  @@index([productId, published])  
  @@map("reviews")  
}
  
// ============ CUPONES ============  
model Coupon {  
  id         String     @id @default(uuid())  
  code       String     @unique  
  type       CouponType  
  value      Decimal    @db.Decimal(10, 2)  
  minAmount  Decimal?   @map("min_amount") @db.Decimal(10, 2)  
  maxUses    Int?       @map("max_uses")  
  usedCount  Int        @default(0) @map("used_count")  
  customerId String?    @map("customer_id")  
  expiresAt  DateTime?  @map("expires_at")  
  campaign   String?  
  active     Boolean    @default(true)  
  createdAt  DateTime   @default(now()) @map("created_at")  
  
  customer Customer?   @relation(fields: [customerId], references: [id])  
  uses     CouponUse[]  
  
  @@index([code])  
  @@index([customerId, active])  
  @@map("coupons")  
} 
  
model CouponUse {  
  id         String   @id @default(uuid())  
  couponId   String   @map("coupon_id")  
  orderId    String   @unique @map("order_id")  
  customerId String   @map("customer_id")  
  usedAt     DateTime @default(now()) @map("used_at")  
  
  coupon Coupon @relation(fields: [couponId], references: [id])  
  order  Order  @relation(fields: [orderId], references: [id])  
  customer Customer @relation(fields: [customerId], references: [id])
  
  @@map("coupon_uses")  
}
  
enum CouponType {  
  PERCENT  
  FIXED  
  FREE_SHIPPING  
}

enum UserRole {
  ADMIN
  CLIENT
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum WaDirection {
  OUTBOUND
  INBOUND
}

enum WaStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
}

enum WaProvider {
  WA_ME
  WABA
  OTHER
}

enum CartStatus {
  ACTIVE
  ABANDONED
  RECOVERING
  RECOVERED
  LOST
}

enum Channel {
  TELEGRAM
  WHATSAPP
}

enum ConvStatus {
  BOT
  HUMAN
  CLOSED
}

enum MsgRole {
  USER
  ASSISTANT
  SYSTEM
}
