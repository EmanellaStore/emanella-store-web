// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// USUARIOS ( accounts )
// ─────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String   // hashed
  name         String
  lastName     String?  @map("last_name")
  phone        String?  @unique
  role         UserRole @default(CLIENT)
  isActive     Boolean  @default(true) @map("is_active")
  resetToken   String?  @map("reset_token") // Token para recuperar contraseña
  resetExpires DateTime? @map("reset_expires") // Cuándo expira el token
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer?

  @@map("users")
}

enum UserRole {
  ADMIN
  CLIENT
}

// ─────────────────────────────────────────
// CLIENTES
// ─────────────────────────────────────────
model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  address   String?
  city      String?
  notes     String?
  userId    String?  @unique @map("user_id")  // ссылка на User если зарегистрирован
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User?    @relation(fields: [userId], references: [id])
  orders     Order[]
  whatsappMessages  WhatsappMessage[]

  @@map("customers")
}

// ─────────────────────────────────────────
// PRODUCTOS
// ─────────────────────────────────────────
model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  category    String   // perfumes | zapatos | bolsos | accesorios
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  variants ProductVariant[]
  images    ProductImage[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  position  Int      @default(0)  // 0-3 para máximo 4 imágenes
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
  @@unique([productId, position])
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  sku            String   @unique
  attributeName  String   @map("attribute_name")  // "Tamaño" | "Color"
  attributeValue String   @map("attribute_value")  // "50ml" | "Negro"
  price          Decimal  @db.Decimal(10, 2)
  stock          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_variants")
}

// ─────────────────────────────────────────
// PEDIDOS
// ─────────────────────────────────────────
model Order {
  id            String      @id @default(uuid())
  customerId    String      @map("customer_id")
  paymentMethod String      @map("payment_method") // transferencia | contraentrega
  totalAmount   Decimal     @db.Decimal(10, 2) @map("total_amount")
  status        OrderStatus @default(PENDIENTE)
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  customer         Customer          @relation(fields: [customerId], references: [id])
  items            OrderItem[]
  events           OrderEvent[]
  whatsappMessages WhatsappMessage[]

  @@map("orders")
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  variantId String  @map("variant_id")
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) @map("unit_price")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_events")
}

// ─────────────────────────────────────────
// WHATSAPP MESSAGE LOG
// ─────────────────────────────────────────
model WhatsappMessage {
  id          String          @id @default(uuid())
  orderId     String?         @map("order_id")
  customerId  String?         @map("customer_id")
  direction   WaDirection     @default(OUTBOUND)
  toPhone     String          @map("to_phone")
  fromPhone   String?         @map("from_phone")
  messageText String          @map("message_text") @db.Text
  context     Json?           // JSON: carrito, totales, método pago, etc.
  status      WaStatus        @default(DRAFT)
  provider    WaProvider      @default(WA_ME)
  sentAt      DateTime?       @map("sent_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  order    Order?    @relation(fields: [orderId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("whatsapp_messages")
}

enum WaDirection {
  OUTBOUND
  INBOUND
}

enum WaStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
}

enum WaProvider {
  WA_ME
  WABA
  OTHER
}